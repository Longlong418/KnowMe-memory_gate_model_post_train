# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
.venv-*/
venv/

# Secrets -- SWANLAB_API_KEY and any data-construction API key live here,
# never in the repository. See docs/training.md section 6 and docs/data.md.
.env

# Model weights. 3.8 GB, downloaded separately; see docs/training.md section 2.
model/
modelscope/

# Training outputs. Checkpoints are hundreds of MB each and are regenerated by
# the training scripts; the numbers they produce are committed instead, under
# eval/results/ -- both metrics.json (and its .hard_haystack / .full_memory
# siblings) and the per-row predictions.jsonl each was scored from, so the
# published numbers can be re-derived instead of taken on trust. Only the runs
# the README quotes are kept, which holds the predictions to ~2 MB; the 14 MB of
# them on disk is mostly the checkpoint sweeps excluded further down.
outputs/
runs/
swanlog/


# Under eval/results/, exactly the runs the README tables quote are published:
#   best_gate_checkpoint_test_3epoch_F1/  -> the Qwen3-1.7B + SFT row
#   grpo_v9/checkpoint-6861_test/         -> the + GRPO row
#   baselines_qwen3_1.7b_test/            -> the Qwen3-1.7B (Base) row
#   api_deepseek-v4.1-flash_test/         -> the DeepSeek V4.1 Flash row
#   api_mimo-v2.6-flash_test/             -> the MiMo-V2.6-Flash row
# Everything else under eval/results/ stays local: the checkpoint sweeps, the
# trial run, the dev evals, and the duplicate SFT test copy (6-epoch_hit_rate is
# bit-identical to 3epoch_F1).
eval/results/grpo_v9/checkpoint-*_dev/
eval/results/grpo_v9/checkpoint-2000_test/
eval/results/grpo_v4_step200_dev/
eval/results/gate_sft_best_checkpoint_dev/
eval/results/best_gate_checkpoint_test_6_epoch_hit_rate/
eval/results/baselines_qwen3_1.7b_dev/

# Local-only analysis notes for the GRPO dev sweep; same genre as docs/results.md.
eval/results/grpo_v9/REPORT.md

# Superseded v1 GRPO data (data/grpo). Its positive memory pool IS the evidence,
# so the rank-aware 1/r reward is constant 1.0 and carries no ranking gradient;
# data/grpo_hard replaced it. The generator (src/dataset/build_grpo_data.py) is
# kept because build_grpo_hard_haystack.py imports from it. Kept on disk, not
# committed.
data/grpo/

# GRPO memory haystacks (data/grpo_hard). 101 MB, and 100% reproducible
# offline in ~30 s by `uv run python -m src.dataset.build_grpo_hard_haystack
# --include-test` (fixed --seed 42, no network, no API key; verified
# byte-identical). gate_grpo_train.jsonl alone is 67 MB, past GitHub's 50 MB
# warning line. Regenerate it before running any eval -- the eval scripts
# default to this path.
data/grpo_hard/

