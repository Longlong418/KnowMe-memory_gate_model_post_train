{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "retrieve",
        "query",
        "reason"
    ],
    "properties": {
        "retrieve": {
            "type": "boolean"
        },
        "query": {
            "type": "string"
        },
        "reason": {
            "type": "string",
            "maxLength": 30
        }
    }
}